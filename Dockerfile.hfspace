FROM ollama/ollama:latest

# Cấu hình môi trường HuggingFace Spaces
ENV OLLAMA_HOST=0.0.0.0:7860
ENV OLLAMA_MODELS=/.ollama/models

# Cấp quyền đọc/ghi cho user mặc định (1000) của HF Spaces
RUN mkdir -p /.ollama/models && chmod -R 777 /.ollama

# Copy entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose port
EXPOSE 7860

# Override ENTRYPOINT của ollama base image, dùng bash để chạy script
ENTRYPOINT ["/bin/bash"]
CMD ["/entrypoint.sh"]
